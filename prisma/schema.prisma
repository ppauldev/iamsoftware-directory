// This is a basic schema - adjust according to your needs
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  role     UserRole  @default(USER)
  reviews  Review[]
  ratings  Rating[]
  websites Website[]
}

enum UserRole {
  USER
  ADMIN
}

model Website {
  id          String    @id @default(cuid())
  url         String    @unique
  name        String
  description String
  thumbnail   String?
  approved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  tags        Tag[]
  reviews     Review[]
  ratings     Rating[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  websites Website[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  websites Website[]
}

model Review {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Rating {
  id        String   @id @default(cuid())
  value     Int
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([websiteId, userId])
} 